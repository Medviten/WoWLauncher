{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WHE Launcher",
  "version": "0.8.6",
  "identifier": "gg.whe.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WHE Launcher",
        "width": 1540,
        "height": 960,
        "minWidth": 1050,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "chat",
        "title": "WHE Chat",
        "url": "chat.html",
        "width": 460,
        "height": 680,
        "minWidth": 340,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "WHE desktop launcher",
    "longDescription": "Launch, update, and follow development news for WHE."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERDUxRTQwMEYwNUE0NkEKUldScXBBVVBRQjdWN1c4NG1oSGJyZ1gxdzRZM0lZWHNsVmdHV0J0M1lKWnVUeUVoeTMyTW5NZ2gK",
      "endpoints": [
        "http://100.110.63.66:7384/launcher-updates/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
